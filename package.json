{
  "name": "read-later-workspace",
  "description": "稍后再看 - monorepo 根（extension / server / mobile）",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter read-later-extension dev",
    "dev:firefox": "pnpm --filter read-later-extension dev:firefox",
    "build": "pnpm --filter read-later-extension build",
    "build:firefox": "pnpm --filter read-later-extension build:firefox",
    "zip": "pnpm --filter read-later-extension zip",
    "zip:firefox": "pnpm --filter read-later-extension zip:firefox",
    "compile": "pnpm --filter read-later-extension compile",
    "typecheck": "pnpm --filter read-later-extension typecheck",
    "typecheck:server": "pnpm --filter read-later-server typecheck",
    "test:unit": "pnpm --filter read-later-extension test:unit",
    "lint": "pnpm --filter read-later-extension lint",
    "lint:fix": "pnpm --filter read-later-extension lint:fix",
    "format": "pnpm --filter read-later-extension format",
    "format:check": "pnpm --filter read-later-extension format:check"
  },
  "packageManager": "pnpm@10.15.1"
}
