# Android SDK 基础镜像：Flutter 镜像 + 项目需要的 platform/build-tools/NDK/CMake
#
# 构建（context 是 mobile/ci）：
#   docker build -f mobile/ci/Dockerfile.sdk -t <registry>/readlater-android-sdk:3.38.10-r1 mobile/ci
#
# 之后 mobile/ci/Dockerfile 默认 FROM 这个镜像，不再执行 sdkmanager 下载。

ARG FLUTTER_IMAGE=ghcr.io/cirruslabs/flutter:3.38.10
ARG SDK_REVISION=dev

FROM ${FLUTTER_IMAGE}
ARG SDK_TEST_BASE_URL
RUN test -n "${SDK_TEST_BASE_URL}" || (echo "SDK_TEST_BASE_URL is required (see mobile/ci/.env)" >&2; exit 1)
ENV SDK_TEST_BASE_URL=${SDK_TEST_BASE_URL}

# 包分开安装，失败时保留已完成层，便于重试
RUN yes | sdkmanager --licenses >/dev/null
RUN sdkmanager --install "platforms;android-34"
RUN sdkmanager --install "platforms;android-35"
RUN sdkmanager --install "build-tools;35.0.0"
RUN sdkmanager --install "ndk;28.2.13676358"
RUN sdkmanager --install "ndk;29.0.13599879"
RUN sdkmanager --install "cmake;3.22.1"

RUN sdkmanager --list_installed | grep -E 'ndk;|cmake;|platforms;android-3|build-tools;3'

# 版本元数据放在最后：每次时间戳 tag 变化不会让上面的 SDK 下载层缓存失效
ARG SDK_REVISION
LABEL org.opencontainers.image.title="readlater-android-sdk"
LABEL org.opencontainers.image.version="${SDK_REVISION}"
LABEL org.opencontainers.image.description="Android SDK extras for ReadLater CI on Flutter 3.38.10"
ENV READLATER_SDK_VERSION=${SDK_REVISION}
