# ReadLater 服务器环境变量配置

# 服务器端口（默认：3000）
PORT=3000

# 数据存储目录（默认：./data）
DATA_DIR=./data

# 允许的前端来源（逗号分隔，默认：* 允许所有）
# 生产环境建议设置为具体域名，如：
# ALLOWED_ORIGINS=https://your-extension.com,https://app.example.com
ALLOWED_ORIGINS=*

# Node 环境（development/production）
NODE_ENV=production

# 图片大小限制（MB，默认：10）
MAX_IMAGE_SIZE_MB=10
