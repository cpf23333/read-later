# CI 镜像构建配置
# 复制本文件为 .env 后填写实际值

# 基础镜像源（默认 node:24）
# 示例：BASE_IMAGE=your-registry/library/node:24
BASE_IMAGE=node:24

# Debian apt 源（留空则使用 Debian 官方源）
# 示例：APT_REPO_DEBIAN=http://your-nexus/repository/debian-bookworm-proxy
APT_REPO_DEBIAN=

# Debian security apt 源（留空则使用 Debian 官方源）
# 示例：APT_REPO_SECURITY=http://your-nexus/repository/debian-security-bookworm-proxy
APT_REPO_SECURITY=

# npm registry（留空则使用 npm 官方源）
# 示例：NPM_REGISTRY=http://your-nexus/repository/npm-proxy/
NPM_REGISTRY=

# Buildah / Skopeo 允许的 HTTP 私有仓库（逗号分隔）
# 示例：INSECURE_REGISTRIES=your-registry:port,another-registry:port
INSECURE_REGISTRIES=
