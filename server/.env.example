# ReadLater 服务器配置
# 复制本文件为 .env 后填写实际值

# API 鉴权密钥（必须）
# 生成命令：openssl rand -base64 32
API_KEY=

# 服务端口（默认 3000）
PORT=3000

# 数据目录（默认当前目录下的 data）
DATA_PATH=./data

# 预构建镜像仓库前缀（留空则本地构建）
# 示例：
#   DOCKER_REGISTRY=cpf23333                   # Docker Hub
#   DOCKER_REGISTRY=your-registry              # 私有仓库
DOCKER_REGISTRY=

# 基础镜像源（留空则使用默认 node:24-alpine）
# 示例：
#   BASE_IMAGE=node:24-alpine                          # Docker Hub 官方镜像
#   BASE_IMAGE=docker.io/library/node:24-alpine        # Docker Hub 完整路径
#   BASE_IMAGE=your-registry/library/node:24-alpine    # 私有镜像仓库/加速服务
BASE_IMAGE=

# CORS 来源（生产环境建议限制为扩展来源）
ALLOWED_ORIGINS=*

# 单张图片大小限制（MB）
MAX_IMAGE_SIZE_MB=10

# 数据库自动备份间隔（小时），0 表示关闭
BACKUP_INTERVAL_HOURS=24

# 保留备份数量
BACKUP_KEEP_COUNT=7

# 日志级别（debug/info/warn/error）
LOG_LEVEL=info
